<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.MainPage"
    BackgroundColor="#1E1E1E">

        <ScrollView>

            <VerticalStackLayout
            Padding="30"
            Spacing="25"
            HorizontalOptions="Center">

                <!-- Title -->
                <Label
                Text="My Calendar"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="White"/>

                <!-- Month -->
                <Label
                Text="March 2026"
                FontSize="20"
                HorizontalOptions="Center"
                TextColor="White"/>

                <!-- Week Header -->
                <Grid
                ColumnDefinitions="*,*,*,*,*,*,*"
                Margin="0,10,0,0">

                    <Label Text="Mon" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Tue" Grid.Column="1" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Wed" Grid.Column="2" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Thu" Grid.Column="3" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Fri" Grid.Column="4" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Sat" Grid.Column="5" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Sun" Grid.Column="6" TextColor="White" HorizontalOptions="Center"/>

                </Grid>

                <!-- Calendar Grid -->
            <Grid
                x:Name="CalendarGrid"
                ColumnDefinitions="*,*,*,*,*,*,*"
                RowDefinitions="*,*,*,*,*,*"
                ColumnSpacing="10"
                RowSpacing="10"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
