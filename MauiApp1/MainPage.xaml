<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.MainPage"
    BackgroundColor="#1E1E1E">

        <ScrollView>

            <VerticalStackLayout
            Padding="30"
            Spacing="25"
            HorizontalOptions="Center">

                <!-- Title -->
                <Label
                Text="My Calendar"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="White"/>

                <!-- Month -->c
                <Label
                Text="March 2026"
                FontSize="20"
                HorizontalOptions="Center"
                TextColor="#BBBBBB"/>

                <!-- Week Header -->
                <Grid
                ColumnDefinitions="*,*,*,*,*,*,*"
                Margin="0,10,0,0">

                    <Label Text="Mon" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Tue" Grid.Column="1" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Wed" Grid.Column="2" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Thu" Grid.Column="3" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Fri" Grid.Column="4" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Sat" Grid.Column="5" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Sun" Grid.Column="6" TextColor="White" HorizontalOptions="Center"/>

                </Grid>

                <!-- Calendar Grid -->
                <Grid
                ColumnDefinitions="*,*,*,*,*,*,*"
                RowDefinitions="*,*,*,*"
                ColumnSpacing="12"
                RowSpacing="12">

                    <!-- Row 1 -->
                    <Button Text="1" Grid.Row="0" Grid.Column="0"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="2" Grid.Row="0" Grid.Column="1"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="3" Grid.Row="0" Grid.Column="2"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="4" Grid.Row="0" Grid.Column="3"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="5" Grid.Row="0" Grid.Column="4"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="6" Grid.Row="0" Grid.Column="5"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="7" Grid.Row="0" Grid.Column="6"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>


                    <!-- Row 2 -->
                    <Button Text="8" Grid.Row="1" Grid.Column="0"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="9" Grid.Row="1" Grid.Column="1"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="10" Grid.Row="1" Grid.Column="2"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="11" Grid.Row="1" Grid.Column="3"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="12" Grid.Row="1" Grid.Column="4"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="13" Grid.Row="1" Grid.Column="5"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="14" Grid.Row="1" Grid.Column="6"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>


                    <!-- Row 3 -->
                    <Button Text="15" Grid.Row="2" Grid.Column="0"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#B5A7E5"
                        TextColor="Black"/>

                    <Button Text="16" Grid.Row="2" Grid.Column="1"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="17" Grid.Row="2" Grid.Column="2"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="18" Grid.Row="2" Grid.Column="3"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="19" Grid.Row="2" Grid.Column="4"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="20" Grid.Row="2" Grid.Column="5"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                    <Button Text="21" Grid.Row="2" Grid.Column="6"
                        HeightRequest="60"
                        CornerRadius="12"
                        BackgroundColor="#9D8BD9"/>

                </Grid>

                <!-- Task Card -->
                <Frame
                BackgroundColor="#2A2A2A"
                CornerRadius="12"
                Padding="20"
                Margin="0,20,0,0"
                WidthRequest="450">

                    <VerticalStackLayout Spacing="8">

                        <Label
                        Text="Tasks"
                        FontAttributes="Bold"
                        FontSize="18"
                        TextColor="White"/>

                        <Label
                        Text="No tasks for this date"
                        TextColor="#AAAAAA"/>

                    </VerticalStackLayout>

                </Frame>

            </VerticalStackLayout>

        </ScrollView>

    </ContentPage>