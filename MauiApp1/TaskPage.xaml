<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.TaskPage"
    BackgroundColor="#1E1E1E">

    <ScrollView>
        <Grid
            x:Name="TaskRootGrid"
            Padding="24"
            RowSpacing="18"
            ColumnSpacing="18">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Top Panel -->
            <VerticalStackLayout
                x:Name="TopPanel"
                Grid.Row="0"
                Grid.Column="0"
                Spacing="16">

                <HorizontalStackLayout Spacing="12">
                    <Button
                        Text="←"
                        Clicked="BackClicked"
                        WidthRequest="50"
                        HeightRequest="50"
                        BackgroundColor="#9D8BD9"
                        TextColor="Black" />

                    <VerticalStackLayout Spacing="6">
                        <Label
                            x:Name="TitleLabel"
                            Text="Tasks"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            x:Name="DateLabel"
                            FontSize="18"
                            TextColor="#BBBBBB" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Add task area -->
                <Border
                    Stroke="#444444"
                    StrokeThickness="1"
                    BackgroundColor="#2A2A2A"
                    Padding="16">

                    <VerticalStackLayout
                        x:Name="InputPanel"
                        Spacing="12">

                        <Label
                            Text="Add Custom Task"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Entry
                            x:Name="TaskEntry"
                            Placeholder="Enter a task"
                            PlaceholderColor="#999999"
                            TextColor="White"
                            BackgroundColor="#3A3A3A" />

                        <Label
                            x:Name="StatusLabel"
                            TextColor="Red"
                            FontSize="14"
                            IsVisible="False" />

                        <Button
                            x:Name="AddTaskButton"
                            Text="Add Task"
                            Clicked="AddTaskClicked"
                            BackgroundColor="#9D8BD9"
                            TextColor="Black" />
                    </VerticalStackLayout>
                </Border>

                <!-- PDF reserved area -->
                <Border
                    Stroke="#444444"
                    StrokeThickness="1"
                    BackgroundColor="#2A2A2A"
                    Padding="16">

                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="Future PDF Import"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Reserved for File System / File Picker and OCR later."
                            TextColor="#BBBBBB" />

                        <Button
                            x:Name="PdfButton"
                            Text="Import PDF"
                            Clicked="ImportPdfClicked"
                            BackgroundColor="#666666"
                            TextColor="White" />

                        <Button
                            Text="Import All Tasks"
                            Clicked="ImportAllPdfClicked"
                            BackgroundColor="#777777"
                            TextColor="White" />

                        <Button
                            Text="Undo Last Import"
                            Clicked="UndoLastImportClicked"
                            BackgroundColor="#555555"
                            TextColor="White" />

                        <Label
                            x:Name="PdfFileNameLabel"
                            Text="No PDF imported yet."
                            TextColor="#BBBBBB"
                            FontSize="14" />

                        <Label
                            x:Name="PdfStatusLabel"
                            TextColor="#BBBBBB"
                            FontSize="13" />    
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- List Panel -->
            <VerticalStackLayout
                x:Name="ListPanel"
                Grid.Row="1"
                Grid.Column="0"
                Spacing="12">

                <Label
                    Text="Task List"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White" />

                <CollectionView
                    x:Name="TaskCollectionView"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Stroke="#444444"
                                StrokeThickness="1"
                                BackgroundColor="#2A2A2A"
                                Padding="12"
                                Margin="0,0,0,10">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label
                                        Text="{Binding Text}"
                                        VerticalOptions="Center"
                                        TextColor="White">

                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="OnEditTaskTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Button
                                        Grid.Column="1"
                                        Text="Delete"
                                        Clicked="DeleteTaskClicked"
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="#E57373"
                                        TextColor="Black" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>